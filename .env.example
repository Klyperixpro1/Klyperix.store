# ==============================================================
# OutreachAI Configuration & API Keys
# You can also configure these dynamically via the Settings tab in the Web App
# ==============================================================

PORT=3001
# Optional Persistent Storage Paths (used in Cloud / Docker)
# DATABASE_PATH=/app/data/leads.db
# WWEBJS_AUTH_PATH=/app/data/.wwebjs_auth

# Google Places API (New)
# Get key from: https://console.cloud.google.com/apis/credentials
# Enable 'Places API (New)'
GOOGLE_PLACES_API_KEY=

# YouTube Data API v3
# Get key from: https://console.cloud.google.com/apis/credentials
# Enable 'YouTube Data API v3'
YOUTUBE_API_KEY=

# Google Gemini API Key (Recommended for AI Pitch generation)
# Get free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Anthropic Claude API Key (Optional)
# Get key from: https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=

# Default Pitch Tone: 'friendly' | 'value_offer' | 'collab' | 'direct'
DEFAULT_PITCH_TONE=friendly

# Force Demo Simulation Mode (true/false)
MOCK_MODE_ENABLED=false
